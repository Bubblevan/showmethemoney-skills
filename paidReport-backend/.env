# Paid Report Backend Configuration (x402 Compliant)
# Copy this file to .env.local for local overrides (do not commit .env.local)

# =============================================================================
# Server Configuration
# =============================================================================
# Server port (default: 8788)
PORT=8788

# =============================================================================
# StablePay Gateway Configuration (x402 Facilitator)
# =============================================================================
# StablePay API Gateway URL - 同时作为 x402 Facilitator
# For production (阿里云): https://ai.wenfu.cn
# For local development: http://127.0.0.1:28080
GATEWAY_BASE_URL=https://ai.wenfu.cn
FACILITATOR_URL=https://ai.wenfu.cn

# StablePay API Key
STABLEPAY_API_KEY=stablepay-dev-key

# =============================================================================
# Seller Configuration
# =============================================================================
# 报告售卖收款钱包（Solana 地址）
SELLER_ADDRESS=4p8F5YAJM8fdrNyvWfb3p6XHx8rboFVV3xn279VXo2j7

# USDC Mint 地址 (Solana Mainnet)
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# =============================================================================
# Security Configuration
# =============================================================================
# Secret used to generate access tokens (CHANGE THIS IN PRODUCTION!)
MERCHANT_PROOF_SECRET=replace-this-with-a-long-random-secret-in-production

# =============================================================================
# Debug/Development Options
# =============================================================================
# Enable debug routes - set to 1 to enable
ENABLE_DEBUG_ROUTES=0

# Internal base URL for debug endpoints (optional)
# INTERNAL_BASE_URL=http://127.0.0.1:8184
